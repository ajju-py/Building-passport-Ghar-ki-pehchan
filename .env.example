# ==================================================
# Building Passport — Civil Digital Identity Platform
# Environment Configuration Template (Stage 2)
# ==================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL 17 — Active Stage 2 Engine)
# Local development endpoint via SSH tunnel: 127.0.0.1:5433
# Target database: building_passport | Role: surya
DATABASE_URL=postgresql://surya:YOUR_PASSWORD_HERE@127.0.0.1:5433/building_passport
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=building_passport
POSTGRES_USER=surya
POSTGRES_PASSWORD=YOUR_PASSWORD_HERE

# Legacy Database Configuration (MongoDB — Deprecating)
MONGODB_URI=mongodb://localhost:27017/building_passport

# Authentication & Security
# Generate a secure 32+ character random string in production
JWT_SECRET=super-secret-building-passport-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend & Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# File Storage Configuration
# Supported drivers: local (extensible to s3, azure_blob, etc.)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Showcase / College Demo Mode
# Set to 'true' to run authentication in showcase mode without external SMTP delivery.
# In showcase mode, OTPs are simulated in-memory and logged to the terminal console.
# Set to 'false' (or leave unset) for standard operation with real transactional email.
SHOWCASE_MODE=false

# Transactional Email & OTP Delivery Configuration
# EMAIL_PROVIDER: smtp (production/staging) or development (local memory sink)
EMAIL_PROVIDER=development
EMAIL_FROM=Building Passport <noreply@buildingpassport.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false


