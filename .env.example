# ==================================================
# Building Passport — Civil Digital Identity Platform
# Environment Configuration Template (Stage 2)
# ==================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# Example local URI: mongodb://localhost:27017/building_passport
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster.mongodb.net/building_passport
MONGODB_URI=mongodb://localhost:27017/building_passport

# Authentication & Security
# Generate a secure 32+ character random string in production
JWT_SECRET=super-secret-building-passport-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend & Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# File Storage Configuration
# Supported drivers: local (extensible to s3, azure_blob, etc.)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
